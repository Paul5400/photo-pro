{
    "name": "photopro/stockage",
    "description": "Service de stockage",
    "require": {
        "php": ">=8.1",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "php-di/slim-bridge": "^3.4",
        "firebase/php-jwt": "^6.11.1",
        "aws/aws-sdk-php": "^3.310",
        "monolog/monolog": "^3.6",
        "vlucas/phpdotenv": "^5.6",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "fakerphp/faker": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "storage\\": "src/"
        }
    },
    "config": {
        "audit": {
            "block-insecure": false
        }
    }
}
