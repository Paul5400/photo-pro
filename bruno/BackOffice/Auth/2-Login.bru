meta {
  name: 2-Login
  type: http
  seq: 3
}

post {
  url: http://localhost:8081/auth/login/photographe
  body: json
  auth: none
}

body:json {
  {
    "email": "photographe@photopro.net",
    "password": "password123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("token", res.getBody().token);
    bru.setEnvVar("photographe_id", res.getBody().photographe.id);
  }
}
