meta {
  name: 05 - Ajouter Photo a Galerie Privee
  type: http
  seq: 5
}

patch {
  url: {{backoffice}}/galeries/{{galerie_privee_id}}/photos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "photo_id": "{{photo_id}}",
    "ordre": 1
  }
}

tests {
  test("Ajout photo galerie privée retourne 200", function() {
    expect(res.status).to.equal(200);
  });
}
