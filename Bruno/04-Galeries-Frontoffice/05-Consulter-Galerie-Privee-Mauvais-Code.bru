meta {
  name: 05 - Consulter Galerie Privee Mauvais Code
  type: http
  seq: 5
}

get {
  url: {{frontoffice}}/galeries/{{galerie_privee_id}}
  body: none
  auth: none
}

params:query {
  code_acces: mauvais-code-invalide
}

tests {
  test("Mauvais code_acces retourne 403", function() {
    expect(res.status).to.equal(403);
  });
}
